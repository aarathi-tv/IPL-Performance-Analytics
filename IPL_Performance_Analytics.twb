        <calculation class='tableau' formula='IF AVG([Economy]) &lt; 7.598&#10;AND SUM([Wickets]) &gt; 39.18&#10;THEN &quot;High Wickets + Low Economy&quot;&#10;&#10;ELSEIF AVG([Economy]) &gt;= 7.598&#10;AND SUM([Wickets]) &gt; 39.18&#10;THEN &quot;High Wickets + High Economy&quot;&#10;&#10;ELSEIF AVG([Economy]) &lt; 7.598&#10;AND SUM([Wickets]) &lt;= 39.18&#10;THEN &quot;Low Wickets + Low Economy&quot;&#10;&#10;ELSE &quot;Low Wickets + High Economy&quot;&#10;END' />
